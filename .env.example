NODE_ENV=development
PORT=8080
HOST=0.0.0.0

DATABASE_URL=postgresql://tore:tore@localhost:5433/tore_legal_data?schema=public
# Integration tests only. Never point this at the corpus public schema.
# Preferred: a dedicated database whose name includes "test"
#   (docker compose postgres_test on 5434):
# TEST_DATABASE_URL=postgresql://tore:tore@localhost:5434/tore_legal_data_test?schema=public
# Fallback when CREATEDB is unavailable: a test schema on the corpus host:
TEST_DATABASE_URL=postgresql://tore:tore@localhost:5432/tore_legal_data?schema=tore_legal_test
REDIS_URL=redis://localhost:6379

# Shared secret the TORE platform will send as Authorization: Bearer <token>
ENGINE_SERVICE_TOKEN=dev-engine-service-token-change-me

# Local immutable archive root (never store user PII here)
ARCHIVE_ROOT=.data/archive

LOG_LEVEL=info

# LegalInfo public ingest (conservative defaults; CLI is dry-run unless --publish)
LEGALINFO_REQUEST_DELAY_MS=4000
LEGALINFO_MAX_CONCURRENCY=1
LEGALINFO_MAX_DOCUMENTS_PER_RUN=5
LEGALINFO_REQUEST_TIMEOUT_MS=20000
LEGALINFO_MAX_RESPONSE_BYTES=8000000
LEGALINFO_MAX_RETRIES=3
LEGALINFO_BASE_URL=https://legalinfo.mn
LEGALINFO_LOCALE=mn
LEGALINFO_CATEGORY_ID=27
LEGALINFO_USER_AGENT=TORE-Legal-Data-Engine/0.3 (+polite official ingest)

