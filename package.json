{
  "name": "tore-legal-data-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative legal source engine for the TORE Legal Operating System.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate:test": "tsx tests/integration/migrate-test-db.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "worker:ingest": "tsx src/workers/run-ingest.ts",
    "worker:parse": "tsx src/workers/run-parse.ts",
    "ingest:legalinfo": "tsx src/cli/ingest-legalinfo.ts",
    "evaluate:corpus": "tsx src/cli/evaluate-corpus.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "prisma": "^6.16.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.7"
  }
}
